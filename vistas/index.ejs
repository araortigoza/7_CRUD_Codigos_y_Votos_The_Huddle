<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Learn It, Love It</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <div class="contenedor">
    <h1>Vota por tu K-drama Favorito</h1>
    
    <a href="/temas/nuevo" class="boton">Agregar Nuevo Tema</a>
    
    <div class="lista-temas">
      <% temas.forEach(tema => { %>
        <div class="tema-card">
          <div class="tema-header">
            <input type="text" class="input-editar" id="tema-titulo-<%= tema.id %>" value="<%= tema.titulo %>">
            <div class="tema-acciones">
              <button class="boton-votar" data-id="<%= tema.id %>" data-tipo="tema" type="button">
                Votar (<%= tema.votos %>)
              </button>
              <button class="boton-actualizar" data-id="<%= tema.id %>" type="button">Guardar</button>
              <button class="boton-eliminar" data-id="<%= tema.id %>" data-tipo="tema" type="button">Eliminar Tema</button>
            </div>
          </div>
          
          <div class="enlaces-container">
            <h3>Enlaces</h3>
            <% tema.enlaces.forEach(enlace => { %>
              <div class="enlace-item">
                <input type="text" class="input-editar" id="enlace-url-<%= enlace.id %>" value="<%= enlace.url %>">
                <button class="boton-votar" data-id="<%= enlace.id %>" data-tipo="enlace" type="button">
                  Votar (<%= enlace.votos %>)
                </button>
                <button class="boton-actualizar-enlace" data-id="<%= enlace.id %>" type="button">Guardar</button>
                <button class="boton-eliminar" data-id="<%= enlace.id %>" data-tipo="enlace" type="button">Eliminar</button>
              </div>
            <% }) %>
            
            <div class="agregar-enlace">
              <input type="text" id="nuevo-enlace-<%= tema.id %>" placeholder="Nueva URL">
              <button class="boton-agregar-enlace" data-tema-id="<%= tema.id %>" type="button">Agregar Enlace</button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  
  <script src="/js/votos.js"></script>
  <script src="/js/temas.js"></script>
  <script src="/js/enlaces.js"></script>
</body>
</html>