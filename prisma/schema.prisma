generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tema {
  id      Int      @id @default(autoincrement())
  titulo  String
  votos   Int      @default(0)
  enlaces Enlace[]
}

model Enlace {
  id      Int    @id @default(autoincrement())
  url     String
  votos   Int    @default(0)
  temaId  Int
  tema    Tema   @relation(fields: [temaId], references: [id], onDelete: Cascade)
}